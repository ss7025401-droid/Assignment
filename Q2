#include <stdio.h>

// Function to merge two sorted arrays into a third sorted array
void mergeSortedArrays(int arr1[], int n1, int arr2[], int n2, int arr3[]) {
    int i = 0;
    int j = 0; 
    int k = 0; 
 
    // Traverse both arrays and pick the smaller element
    while (i < n1 && j < n2) {
        if (arr1[i] <= arr2[j]) {
            arr3[k] = arr1[i];
            i++;
        } else {
            arr3[k] = arr2[j];
            j++;
        }
        k++;
    }

    // Store remaining elements of first array (if any)
    while (i < n1) {
        arr3[k] = arr1[i];
        i++;
        k++;
    }

    // Store remaining elements of second array (if any)
    while (j < n2) {
        arr3[k] = arr2[j];
        j++;
        k++;
    }
}

int main() {
    int arr1[] = {1, 3, 5, 7};
    int n1 = sizeof(arr1) / sizeof(arr1[0]);

    int arr2[] = {2, 4, 6, 8, 10};
    int n2 = sizeof(arr2) / sizeof(arr2[0]);

    // Destination array must be large enough to hold elements of both arrays
    int arr3[n1 + n2];

    mergeSortedArrays(arr1, n1, arr2, n2, arr3);

    printf("Merged sorted array: ");
    for (int i = 0; i < n1 + n2; i++) {
        printf("%d ", arr3[i]);
    }
    printf("\n");

    return 0;
}
