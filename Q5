
#include <stdio.h>

int main() {
    int a[100], stack[100], nge[100];
    int n, top = -1, i;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    // Find Next Greater Element
    for(i = n - 1; i >= 0; i--) {

        while(top != -1 && stack[top] <= a[i]) {
            top--;
        }

        if(top == -1) {
            nge[i] = -1;
        }
        else {
            nge[i] = stack[top];
        }

        stack[++top] = a[i];
    }

    printf("Next Greater Elements:\n");

    for(i = 0; i < n; i++) {
        printf("%d -> %d\n", a[i], nge[i]);
    }

    return 0;
}
