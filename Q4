
#include <stdio.h>

int main() {
    int a[100], n, k, i, temp[100];

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for(i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    printf("Enter number of positions to rotate: ");
    scanf("%d", &k);

    k = k % n;

    for(i = 0; i < n; i++) {
        temp[(i + k) % n] = a[i];
    }

    printf("Array after rotation: ");
    for(i = 0; i < n; i++) {
        printf("%d ", temp[i]);
    }

    return 0;
}
